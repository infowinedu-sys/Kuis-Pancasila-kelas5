/* ============================================================
   GAME FLOW
   ============================================================ */
function startGame() {
  idx = 0;
  score = 0;
  correctCount = 0;
  wrongCount = 0;
  streak = 0;
  bestStreak = 0;
  chapterStats = {};
  questions.forEach(q => {
    if (!chapterStats[q.ch]) chapterStats[q.ch] = { correct: 0, total: 0 };
  });
  startTime = Date.now();

  updateHUD();
  $("playerName").textContent = playerName;
  $("playerRole").textContent = "Pembalap · Kelas " + playerClass;
  const avatar = $("avatar");
  avatar.textContent = playerName.charAt(0).toUpperCase();
  avatar.style.background = hashColor(playerName);

  showScreen("quiz");
  moveCar(false);
  renderQuestion();
}

function renderQuestion() {
  answered = false;
  lastWarnTick = -1;
  const q = questions[idx];

  $("qBadge").textContent = "Soal " + (idx + 1);
  $("qChapter").textContent = q.ch;
  $("qText").textContent = q.q;

  $("feedback").className = "feedback";
  $("feedback").textContent = "";
  $("nextBtn").classList.remove("show");
  $("nextBtn").textContent = (idx === TOTAL - 1) ? "🏁 Lihat Hasil" : "Soal Berikutnya →";

  $("options").innerHTML = "";
  q.o.forEach((text, i) => {
    const btn = document.createElement("button");
    btn.className = "opt";
    btn.innerHTML = `
      <span class="opt-letter">${LETTERS[i]}</span>
      <span class="opt-text">${text}</span>
      <svg class="opt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    `;
    btn.addEventListener("click", () => selectAnswer(i));
    $("options").appendChild(btn);
  });

  startTimer();
}

/* ============================================================
   TIMER
   ============================================================ */
function startTimer() {
  clearTimer();
  timeLeft = TIME_PER_Q;
  updateTimerUI();
  timerInterval = setInterval(() => {
    timeLeft--;
    updateTimerUI();

    if ([10, 5, 3, 2, 1].includes(timeLeft) && timeLeft !== lastWarnTick) {
      lastWarnTick = timeLeft;
      sfx.warning();
    }

    if (timeLeft <= 0) {
      clearTimer();
      handleTimeout();
    }
  }, 1000);
}

function clearTimer() {
  if (timerInterval) {
    clearInterval(timerInterval);
    timerInterval = null;
  }
}

function updateTimerUI() {
  const pct = Math.max(0, timeLeft / TIME_PER_Q);
  const offset = RING_CIRC * (1 - pct);
  const ring = $("ringProgress");
  ring.style.strokeDashoffset = offset;

  let color = "var(--success-500)";
  if (timeLeft <= 10) color = "var(--danger-500)";
  else if (timeLeft <= 20) color = "var(--warning-500)";
  ring.style.stroke = color;

  $("timerNum").textContent = timeLeft;
  $("timerNum").style.color = timeLeft <= 10 ? "var(--danger-600)" : "var(--n-900)";
}

function handleTimeout() {
  if (answered) return;
  answered = true;

  const q = questions[idx];
  const buttons = [...$("options").children];
  buttons.forEach((b, i) => {
    b.disabled = true;
    if (i === q.a) b.classList.add("correct");
    else b.classList.add("dim");
  });

  wrongCount++;
  streak = 0;
  chapterStats[q.ch].total++;
  updateHUD();
  pulseStat($("statStreak"));

  $("feedback").className = "feedback no show";
  $("feedback").textContent = `⏰ Waktu habis! Jawaban benar: ${LETTERS[q.a]}. ${q.o[q.a]}`;
  $("nextBtn").classList.add("show");
  sfx.timeUp();
}

/* ============================================================
   ANSWER
   ============================================================ */
function selectAnswer(chosen) {
  if (answered) return;
  answered = true;
  clearTimer();

  const q = questions[idx];
  const buttons = [...$("options").children];
  const isCorrect = (chosen === q.a);

  buttons.forEach((b, i) => {
    b.disabled = true;
    if (i === q.a) b.classList.add("correct");
    else if (i === chosen) b.classList.add("wrong");
    else b.classList.add("dim");
  });

  chapterStats[q.ch].total++;

  if (isCorrect) {
    correctCount++;
    streak++;
    if (streak > bestStreak) bestStreak = streak;
    chapterStats[q.ch].correct++;

    const timeBonus = Math.round(timeLeft / 5);
    const streakBonus = Math.min(streak, 5);
    const gained = 10 + timeBonus + streakBonus;
    score += gained;

    updateHUD();
    pulseStat($("statScore"));
    pulseStat($("statCorrect"));

    $("feedback").className = "feedback ok show";
    $("feedback").textContent = `✅ Benar! +${gained} poin (${timeBonus} bonus waktu · ${streakBonus} bonus streak). Mobil melaju!`;
    $("nextBtn").classList.add("show");

    moveCar(true);
    spawnSmoke();
    sfx.correct();
  } else {
    wrongCount++;
    streak = 0;
    updateHUD();
    pulseStat($("statStreak"));

    $("feedback").className = "feedback no show";
    $("feedback").textContent = `❌ Kurang tepat. Mobil diam. Jawaban benar: ${LETTERS[q.a]}. ${q.o[q.a]}`;
    $("nextBtn").classList.add("show");
    sfx.wrong();
  }
}

function updateHUD() {
  $("scoreVal").textContent = score;
  $("correctVal").textContent = correctCount;
  $("streakVal").textContent = streak;
}

/* ============================================================
   CAR + SMOKE
   ============================================================ */
function moveCar(animate) {
  const road = $("road");
  const car = $("car");
  const maxLeft = road.clientWidth - car.offsetWidth - 44;
  const progress = correctCount / TOTAL;
  car.style.left = Math.max(0, progress * maxLeft) + "px";

  if (animate) {
    car.classList.remove("driving");
    void car.offsetWidth;
    car.classList.add("driving");
    setTimeout(() => car.classList.remove("driving"), 700);
  }
  $("progressLabel").textContent = Math.round(progress * 100) + "% menuju finish";
}

function spawnSmoke() {
  const road = $("road");
  const car = $("car");
  const carRect = car.getBoundingClientRect();
  const roadRect = road.getBoundingClientRect();
  const left = carRect.left - roadRect.left;
  const bottom = roadRect.bottom - carRect.bottom;

  for (let i = 0; i < 3; i++) {
    const puff = document.createElement("div");
    puff.className = "smoke";
    puff.style.left = (left - 4 + Math.random() * 16) + "px";
    puff.style.bottom = (bottom + 8 + Math.random() * 6) + "px";
    road.appendChild(puff);
    setTimeout(() => puff.remove(), 950);
  }
}

/* ============================================================
   NEXT / FINISH
   ============================================================ */
$("nextBtn").addEventListener("click", () => {
  if (idx === TOTAL - 1) {
    finishGame();
  } else {
    idx++;
    renderQuestion();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }
});

function finishGame() {
  clearTimer();
  sfx.finish();

  const elapsed = Math.round((Date.now() - startTime) / 1000);
  const pct = Math.round((correctCount / TOTAL) * 100);

  const result = {
    name: playerName,
    class: playerClass,
    score,
    correct: correctCount,
    wrong: wrongCount,
    total: TOTAL,
    accuracy: pct,
    bestStreak,
    timeSeconds: elapsed,
    date: new Date().toISOString()
  };
  saveResult(result);

  $("rScore").textContent = score;
  $("rCorrect").textContent = correctCount;
  $("rWrong").textContent = wrongCount;
  $("rStreak").textContent = bestStreak;
  $("resultPercent").textContent = pct + "%";

  const ring = $("resultRing");
  ring.style.strokeDashoffset = RING_CIRC;
  requestAnimationFrame(() => {
    setTimeout(() => {
      ring.style.strokeDashoffset = RING_CIRC * (1 - pct / 100);
      ring.style.stroke = pct >= 80 ? "var(--success-500)"
        : pct >= 60 ? "var(--brand-500)"
        : pct >= 40 ? "var(--warning-500)"
        : "var(--danger-500)";
    }, 100);
  });

  let title, msg;
  if (pct === 100) { title = "Balapan Sempurna! 🏆"; msg = "Kamu menjawab semua soal dengan benar. Mobil mencapai garis finish!"; }
  else if (pct >= 80) { title = "Luar Biasa! 🥇"; msg = "Pemahamanmu tentang Pancasila dan norma sangat kuat. Hampir sempurna!"; }
  else if (pct >= 60) { title = "Balapan Bagus! 🚗"; msg = "Pemahamanmu sudah baik. Pelajari kembali soal yang salah agar mobilmu melaju lebih jauh."; }
  else if (pct >= 40) { title = "Terus Semangat! 📚"; msg = "Kamu sudah berusaha. Baca ulang Bab 1 dan Bab 2 lalu coba lagi ya!"; }
  else { title = "Jangan Menyerah! 💪"; msg = "Pelajari kembali nilai-nilai Pancasila dan norma-norma dalam kehidupan sehari-hari."; }

  $("resultTitle").textContent = title;
  $("resultMsg").textContent = msg;

  const breakdown = $("chapterBreakdown");
  const rows = Object.entries(chapterStats).map(([ch, s]) => {
    const p = s.total > 0 ? (s.correct / s.total) * 100 : 0;
    const color = p >= 80 ? "var(--success-500)" : p >= 60 ? "var(--brand-500)" : p >= 40 ? "var(--warning-500)" : "var(--danger-500)";
    return `
      <div class="chapter-row">
        <span class="chapter-row-label">${ch}</span>
        <span class="chapter-row-score">${s.correct}/${s.total}</span>
        <div class="chapter-row-bar"><div class="chapter-row-fill" style="width:${p}%;background:${color}"></div></div>
      </div>`;
  }).join("");
  breakdown.innerHTML = `<div class="chapter-breakdown-title">Performa per Kategori</div>` + rows;

  if (pct >= 80) launchConfetti();

  showScreen("result");
}

/* ============================================================
   STORAGE
   ============================================================ */
function saveResult(result) {
  try {
    const all = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    all.push(result);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
  } catch (e) { console.warn("Save failed:", e); }
}

function loadResults() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); }
  catch (e) { return []; }
}

/* ============================================================
   HISTORY
   ============================================================ */
let historyFilter = "";

function renderHistory() {
  const all = loadResults().sort((a, b) => new Date(b.date) - new Date(a.date));
  const summary = $("historySummary");
  const body = $("historyBody");

  if (all.length === 0) {
    summary.innerHTML = "";
    body.innerHTML = `
      <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
        <h3>Belum ada riwayat</h3>
        <p>Selesaikan satu kuis dan hasilnya akan muncul di sini.</p>
      </div>`;
    return;
  }

  const avgScore = Math.round(all.reduce((s, r) => s + r.score, 0) / all.length);
  const bestScore = Math.max(...all.map(r => r.score));
  summary.innerHTML = `
    <div class="history-summary-card"><span class="sum-val">${all.length}</span><span class="sum-lbl">Total Percobaan</span></div>
    <div class="history-summary-card"><span class="sum-val">${avgScore}</span><span class="sum-lbl">Rata-rata Skor</span></div>
    <div class="history-summary-card"><span class="sum-val">${bestScore}</span><span class="sum-lbl">Skor Terbaik</span></div>
  `;

  const filtered = historyFilter
    ? all.filter(r => r.name.toLowerCase().includes(historyFilter.toLowerCase()))
    : all;

  if (filtered.length === 0) {
    body.innerHTML = `<div class="empty-state"><h3>Tidak ada hasil</h3><p>Tidak ada siswa dengan nama "${escapeHtml(historyFilter)}".</p></div>`;
    return;
  }

  const rows = filtered.map((r, i) => {
    const isYou = playerName && r.name.toLowerCase() === playerName.toLowerCase();
    const scoreCls = r.accuracy >= 80 ? "good" : r.accuracy >= 60 ? "mid" : "low";
    const d = new Date(r.date);
    const dateStr = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) + ' · ' +
                    d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    return `
      <tr class="${isYou ? "is-you" : ""}">
        <td>${i + 1}</td>
        <td><strong>${escapeHtml(r.name)}</strong>${isYou ? '<span class="you-tag">KAMU</span>' : ""}</td>
        <td>${escapeHtml(r.class)}</td>
        <td><span class="score-pill ${scoreCls}">${r.score}</span></td>
        <td>${r.correct}/${r.total}</td>
        <td>${r.accuracy}%</td>
        <td>${r.bestStreak}</td>
        <td>${formatTime(r.timeSeconds)}</td>
        <td style="color:var(--n-500);font-size:12px;white-space:nowrap;">${dateStr}</td>
      </tr>`;
  }).join("");

  body.innerHTML = `
    <div class="table-wrap">
      <table class="history-table">
        <thead><tr>
          <th>#</th><th>Nama</th><th>Kelas</th><th>Skor</th><th>Benar</th>
          <th>Akurasi</th><th>Streak</th><th>Waktu</th><th>Tanggal</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <p style="text-align:center;margin-top:16px;font-size:12px;color:var(--n-400);">
      Menampilkan ${filtered.length} dari ${all.length} percobaan ·
      <a href="#" id="clearAllLink" style="color:var(--danger-600);font-weight:700;text-decoration:none;">Hapus semua riwayat</a>
    </p>`;

  const link = document.getElementById("clearAllLink");
  if (link) {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      if (confirm("Hapus semua riwayat? Tidak dapat dibatalkan.")) {
        localStorage.removeItem(STORAGE_KEY);
        renderHistory();
      }
    });
  }
}

$("historySearch").addEventListener("input", (e) => {
  historyFilter = e.target.value;
  renderHistory();
});

function exportCSV() {
  const all = loadResults();
  if (all.length === 0) {
    alert("Belum ada riwayat untuk diekspor.");
    return;
  }
  const header = ["Nama", "Kelas", "Skor", "Benar", "Salah", "Total", "Akurasi", "Streak", "Waktu (detik)", "Tanggal"];
  const rows = all.map(r => [
    `"${String(r.name).replace(/"/g, '""')}"`,
    `"${String(r.class).replace(/"/g, '""')}"`,
    r.score, r.correct, r.wrong, r.total, r.accuracy + "%",
    r.bestStreak, r.timeSeconds,
    `"${new Date(r.date).toLocaleString('id-ID')}"`
  ].join(","));
  const csv = [header.join(","), ...rows].join("\n");
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "laporan_pancasila_kelas5_" + new Date().toISOString().slice(0, 10) + ".csv";
  a.click();
  URL.revokeObjectURL(url);
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}

function formatTime(sec) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return m > 0 ? `${m}m ${s}s` : `${s}s`;
}

/* ============================================================
   CONFETTI
   ============================================================ */
function launchConfetti() {
  const canvas = $("confetti");
  const ctx = canvas.getContext("2d");
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const colors = ["#ea580c", "#f97316", "#fbbf24", "#22c55e", "#3b82f6", "#ec4899"];
  const parts = [];
  for (let i = 0; i < 100; i++) {
    parts.push({
      x: Math.random() * canvas.width,
      y: -20 - Math.random() * 200,
      vx: (Math.random() - 0.5) * 4,
      vy: Math.random() * 3 + 2,
      size: Math.random() * 8 + 4,
      color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * Math.PI,
      vrot: (Math.random() - 0.5) * 0.3
    });
  }

  let frames = 0;
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    parts.forEach(p => {
      p.x += p.vx; p.y += p.vy; p.vy += 0.08; p.rot += p.vrot;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
      ctx.restore();
    });
    frames++;
    if (frames < 220) requestAnimationFrame(animate);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  animate();
}

