/* ============================================================
   LOGIN
   ============================================================ */
$("startBtn").addEventListener("click", () => {
  const name = $("studentName").value.trim();
  const cls = $("studentClass").value.trim();
  const nameErr = $("nameError");
  const classErr = $("classError");

  let hasError = false;
  if (!name) {
    $("studentName").classList.add("error");
    nameErr.classList.add("show");
    hasError = true;
  } else {
    $("studentName").classList.remove("error");
    nameErr.classList.remove("show");
  }
  if (!cls) {
    $("studentClass").classList.add("error");
    classErr.classList.add("show");
    hasError = true;
  } else {
    $("studentClass").classList.remove("error");
    classErr.classList.remove("show");
  }

