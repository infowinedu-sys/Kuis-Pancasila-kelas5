const TOTAL = questions.length;
const TIME_PER_Q = 50;
const LETTERS = ["A","B","C","D"];
const STORAGE_KEY = "pancasila_racing_kelas5_v1";
const RING_CIRC = 2 * Math.PI * 44;

/* ============================================================
   STATE
   ============================================================ */
let playerName = "";
let playerClass = "";
let idx = 0;
let score = 0;
let correctCount = 0;
let wrongCount = 0;
let streak = 0;
let bestStreak = 0;
let answered = false;
let startTime = 0;
let chapterStats = {};
let historyReturnTo = "login";

let timerInterval = null;
let timeLeft = TIME_PER_Q;
let lastWarnTick = -1;

let audioCtx = null;
let muted = false;

/* ============================================================
   DOM HELPERS
   ============================================================ */
const $ = (id) => document.getElementById(id);
const screens = {
  login: $("loginScreen"),
  quiz: $("quizScreen"),
  result: $("resultScreen"),
  history: $("historyScreen")
};

function showScreen(name) {
  Object.values(screens).forEach(s => s.classList.remove("active"));
  screens[name].classList.add("active");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function pulseStat(node) {
  node.classList.remove("pulse");
  void node.offsetWidth;
  node.classList.add("pulse");
  setTimeout(() => node.classList.remove("pulse"), 500);
}

function hashColor(name) {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) | 0;
  const hue = Math.abs(h) % 360;
  return `hsl(${hue}, 65%, 45%)`;
}

/* ============================================================
   AUDIO
   ============================================================ */
function getAudio() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch (e) { return null; }
  }
  if (audioCtx.state === "suspended") audioCtx.resume();
  return audioCtx;
}

function playTone(freq, duration, type = "sine", delay = 0, vol = 0.15) {
  if (muted) return;
  const ctx = getAudio();
  if (!ctx) return;
  const now = ctx.currentTime + delay;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(0.0001, now);
  gain.gain.linearRampToValueAtTime(vol, now + 0.012);
  gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(now);
  osc.stop(now + duration + 0.05);
}

const sfx = {
  correct() {
    playTone(523, 0.10, "sine", 0.00, 0.14);
    playTone(659, 0.10, "sine", 0.08, 0.14);
    playTone(784, 0.20, "sine", 0.16, 0.16);
  },
  wrong() {
    playTone(220, 0.16, "sawtooth", 0.00, 0.10);
    playTone(165, 0.24, "sawtooth", 0.12, 0.10);
  },
  warning() { playTone(880, 0.06, "square", 0, 0.07); },
  timeUp() {
    playTone(330, 0.18, "sawtooth", 0, 0.12);
