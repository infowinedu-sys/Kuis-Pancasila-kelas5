<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pancasila Racing Quiz — Kelas 5</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Exo+2:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --brand-50:#fff7ed; --brand-100:#ffedd5; --brand-200:#fed7aa;
  --brand-300:#fdba74; --brand-400:#fb923c; --brand-500:#f97316;
  --brand-600:#ea580c; --brand-700:#c2410c; --brand-800:#9a3412;

  --success-50:#f0fdf4; --success-100:#dcfce7; --success-500:#22c55e;
  --success-600:#16a34a; --success-700:#15803d;

  --danger-50:#fef2f2; --danger-100:#fee2e2; --danger-500:#ef4444;
  --danger-600:#dc2626; --danger-700:#b91c1c;

  --warning-50:#fffbeb; --warning-100:#fef3c7; --warning-500:#f59e0b;
  --warning-600:#d97706;

  --n-0:#fff; --n-50:#f8fafc; --n-100:#f1f5f9; --n-200:#e2e8f0;
  --n-300:#cbd5e1; --n-400:#94a3b8; --n-500:#64748b; --n-600:#475569;
  --n-700:#334155; --n-800:#1e293b; --n-900:#0f172a;

  --r-sm:10px; --r-md:16px; --r-lg:24px; --r-full:9999px;

  --shadow-xs: 0 1px 2px rgba(15,23,42,.04);
  --shadow-sm: 0 1px 2px rgba(15,23,42,.04), 0 2px 4px rgba(15,23,42,.04);
  --shadow-md: 0 1px 2px rgba(15,23,42,.04), 0 4px 8px rgba(15,23,42,.05), 0 12px 24px rgba(15,23,42,.04);
  --shadow-lg: 0 1px 2px rgba(15,23,42,.04), 0 8px 16px rgba(15,23,42,.06), 0 20px 40px rgba(15,23,42,.06);
  --shadow-xl: 0 4px 8px rgba(15,23,42,.06), 0 16px 32px rgba(15,23,42,.08), 0 32px 64px rgba(15,23,42,.08);

  --border: 1px solid var(--n-200);
  --border-subtle: 1px solid rgba(15,23,42,.06);

  --ease: cubic-bezier(.4,0,.2,1);
  --t-fast: 150ms var(--ease);
  --t-base: 200ms var(--ease);
  --t-slow: 300ms var(--ease);
}

* { -webkit-font-smoothing: antialiased; }

body {
  font-family: 'Exo 2', system-ui, sans-serif;
  color: var(--n-800);
  background:
    radial-gradient(ellipse 60% 50% at 15% 0%, rgba(249,115,22,.10), transparent 60%),
    radial-gradient(ellipse 50% 40% at 85% 100%, rgba(234,88,12,.07), transparent 60%),
    linear-gradient(180deg, #fffbf7 0%, #fef6ee 100%);
  min-height: 100vh;
  font-size: 15px;
  line-height: 1.5;
  display: flex;
  justify-content: center;
  padding: 16px;
}

button { font-family: inherit; cursor: pointer; border: none; background: none; }
input { font-family: inherit; }

:focus-visible {
  outline: 2px solid var(--brand-500);
  outline-offset: 2px;
  border-radius: var(--r-sm);
}

.font-display { font-family: 'Russo One', 'Exo 2', sans-serif; letter-spacing: 1px; }

.app { width: 100%; max-width: 1100px; padding: 12px 0 40px; }

.screen { display: none; }
.screen.active { display: block; animation: fadeIn 300ms ease-out; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============ BUTTONS ============ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 22px; border-radius: var(--r-sm);
  font-size: 15px; font-weight: 700; letter-spacing: .01em;
  transition: transform var(--t-fast), box-shadow var(--t-base), background var(--t-fast);
  white-space: nowrap; user-select: none;
}
.btn:active:not(:disabled) { transform: scale(.97); }
.btn:disabled { opacity: .5; cursor: not-allowed; }

.btn-primary {
  background: var(--brand-600); color: #fff;
  box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 4px 12px rgba(234,88,12,.30);
}
.btn-primary:hover:not(:disabled) {
  background: var(--brand-700);
  box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 8px 20px rgba(234,88,12,.38);
}

.btn-success {
  background: var(--success-600); color: #fff;
  box-shadow: 0 1px 2px rgba(15,23,42,.08), 0 4px 12px rgba(22,163,74,.30);
}
.btn-success:hover:not(:disabled) { background: var(--success-700); }

.btn-secondary {
  background: var(--n-0); color: var(--brand-700);
  border: 1px solid var(--n-200);
  box-shadow: var(--shadow-xs);
}
.btn-secondary:hover:not(:disabled) { border-color: var(--brand-300); background: var(--brand-50); }

.btn-text {
  color: var(--n-600); font-weight: 600; padding: 8px 12px; font-size: 14px;
}
.btn-text:hover { color: var(--brand-700); }

.btn-block { width: 100%; }

/* ============ LOGIN ============ */
.login-wrap {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 32px;
  max-width: 980px;
  margin: 0 auto;
  padding-top: 24px;
}

.login-hero {
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20px;
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  align-self: flex-start;
  padding: 6px 12px;
  background: var(--brand-50); color: var(--brand-700);
  border-radius: var(--r-full);
  font-size: 12px; font-weight: 800;
  letter-spacing: .08em; text-transform: uppercase;
  border: 1px solid var(--brand-100);
}

.hero-title {
  font-family: 'Russo One', sans-serif;
  font-size: 40px; line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--n-900);
}
.hero-title .accent { color: var(--brand-600); }

.hero-sub {
  font-size: 16px; color: var(--n-600);
  line-height: 1.55; max-width: 420px;
}

.hero-features { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
.hero-feature {
  display: flex; align-items: center; gap: 12px;
  color: var(--n-700); font-size: 14px; font-weight: 600;
}
.hero-feature-icon {
  width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center;
  background: var(--brand-50); border-radius: var(--r-sm);
  color: var(--brand-600); flex-shrink: 0;
}

.hero-road {
  margin-top: 20px; height: 48px;
  border-radius: var(--r-sm);
  background: linear-gradient(180deg, #334155 0%, #1e293b 100%);
  position: relative; overflow: hidden;
  border: 2px solid var(--warning-500);
}
.hero-road::before {
  content: ''; position: absolute;
  left: 0; right: 0; top: 50%; height: 3px;
  transform: translateY(-50%);
  background: repeating-linear-gradient(90deg, var(--warning-500) 0 20px, transparent 20px 40px);
  opacity: .7;
}
.hero-car-anim {
  position: absolute; top: 50%; font-size: 26px;
  transform: translateY(-50%);
  animation: driveIn 6s linear infinite;
}
@keyframes driveIn {
  0%   { left: -40px; }
  100% { left: calc(100% + 20px); }
}

.login-card {
  background: var(--n-0); border-radius: var(--r-lg);
  padding: 32px 24px;
  box-shadow: var(--shadow-lg);
  border: var(--border-subtle);
  align-self: center;
}
.login-card h2 {
  font-family: 'Russo One', sans-serif;
  font-size: 24px; color: var(--n-900);
  margin-bottom: 6px;
}
.login-card .card-sub {
  color: var(--n-500); font-size: 14px;
  margin-bottom: 24px; line-height: 1.5;
}

.field { margin-bottom: 16px; }
.field-label {
  display: block; font-size: 11px; font-weight: 800;
  color: var(--n-600); letter-spacing: .08em;
  text-transform: uppercase; margin-bottom: 6px;
}
.field-input {
  width: 100%; padding: 14px 16px;
  border: 1.5px solid var(--n-200);
  border-radius: var(--r-sm);
  font-size: 15px; color: var(--n-800);
  background: var(--n-50);
  transition: border-color var(--t-fast), background var(--t-fast), box-shadow var(--t-fast);
}
.field-input::placeholder { color: var(--n-400); }
.field-input:focus {
  outline: none; border-color: var(--brand-500);
  background: var(--n-0);
  box-shadow: 0 0 0 3px var(--brand-100);
}
.field-input.error {
  border-color: var(--danger-500); background: var(--danger-50);
  box-shadow: 0 0 0 3px var(--danger-100);
}
.field-error {
  font-size: 12px; color: var(--danger-600);
  font-weight: 600; margin-top: 6px; display: none;
}
.field-error.show { display: block; }

.login-footer {
  margin-top: 20px; padding-top: 20px;
  border-top: 1px solid var(--n-100);
  text-align: center;
}

/* ============ TOPBAR ============ */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px;
  background: var(--n-0); border-radius: var(--r-md);
  padding: 12px 16px;
  box-shadow: var(--shadow-sm);
  border: var(--border-subtle);
  margin-bottom: 16px;
}
.player-chip { display: flex; align-items: center; gap: 12px; min-width: 0; }
.avatar {
  width: 38px; height: 38px; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-family: 'Russo One', sans-serif; font-size: 15px;
  flex-shrink: 0;
  box-shadow: inset 0 -2px 4px rgba(0,0,0,.15);
}
.player-info { min-width: 0; }
.player-name {
  font-weight: 700; font-size: 14px; color: var(--n-900);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 200px;
}
.player-role {
  font-size: 11px; color: var(--n-500);
  font-weight: 600; letter-spacing: .04em;
  text-transform: uppercase;
}

.icon-btn {
  width: 40px; height: 40px; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  color: var(--n-600); background: var(--n-50);
  border: 1px solid var(--n-200);
  transition: all var(--t-fast); flex-shrink: 0;
}
.icon-btn:hover { background: var(--n-100); color: var(--n-800); }
.icon-btn svg { width: 18px; height: 18px; }

/* ============ TRACK ============ */
.track-wrap {
  background: var(--n-0); border-radius: var(--r-md);
  padding: 16px; box-shadow: var(--shadow-sm);
  border: var(--border-subtle); margin-bottom: 16px;
}
.track-head {
  display: flex; justify-content: space-between;
  align-items: center; margin-bottom: 12px;
  gap: 12px; flex-wrap: wrap;
}
.track-title {
  font-family: 'Russo One', sans-serif;
  font-size: 13px; color: var(--n-500);
  letter-spacing: .1em; text-transform: uppercase;
}
.track-progress-label {
  font-size: 13px; font-weight: 700; color: var(--brand-700);
  font-variant-numeric: tabular-nums;
}
.road {
  position: relative; height: 76px;
  border-radius: var(--r-sm);
  background: linear-gradient(180deg, #334155 0%, #0f172a 100%);
  overflow: hidden;
  border: 2px solid var(--warning-500);
}
.road::before {
  content: ''; position: absolute;
  left: 0; right: 0; top: 50%; height: 4px;
  transform: translateY(-50%);
  background: repeating-linear-gradient(90deg, rgba(251,191,36,.75) 0 24px, transparent 24px 48px);
}
.checkpoint {
  position: absolute; top: 50%; width: 2px; height: 16px;
  background: rgba(251,191,36,.55);
  transform: translate(-50%, -50%);
}
.road-label {
  position: absolute; bottom: 4px;
  font-family: 'Russo One', sans-serif;
  font-size: 9px; letter-spacing: .1em;
  color: rgba(255,255,255,.55);
}
.road-label.start { left: 8px; }
.road-label.finish { right: 46px; }
.finish-line {
  position: absolute; right: 0; top: 0; bottom: 0; width: 38px;
  background: repeating-conic-gradient(var(--n-900) 0% 25%, #fff 0% 50%) 0 / 10px 10px;
  border-left: 2px solid var(--warning-500);
  opacity: .9;
}
.car {
  position: absolute; bottom: 6px; left: 0;
  font-size: 38px; line-height: 1; z-index: 3;
  transition: left 800ms cubic-bezier(.34,1.4,.5,1);
  filter: drop-shadow(0 4px 6px rgba(0,0,0,.5));
  animation: carIdle 2.4s ease-in-out infinite;
}
@keyframes carIdle {
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(-1px); }
}
.car.driving { animation: vroom 350ms ease-in-out 2; }
@keyframes vroom {
  0%,100% { transform: translateY(0) rotate(0); }
  50%     { transform: translateY(-8px) rotate(-3deg); }
}

.smoke {
  position: absolute; width: 12px; height: 12px;
  background: rgba(220, 220, 220, .75);
  border-radius: 50%; pointer-events: none; z-index: 2;
  animation: smokeFade 900ms ease-out forwards;
}
@keyframes smokeFade {
  0%   { transform: scale(1) translateY(0); opacity: .75; }
  100% { transform: scale(2.4) translateY(-14px); opacity: 0; }
}

/* ============ QUIZ GRID ============ */
.quiz-grid {
  display: grid; grid-template-columns: 1fr 300px;
  gap: 16px; align-items: start;
}

.side-panel { display: flex; flex-direction: column; gap: 16px; }

.timer-widget {
  background: var(--n-0); border-radius: var(--r-md);
  padding: 20px; box-shadow: var(--shadow-sm);
  border: var(--border-subtle);
  display: flex; flex-direction: column;
  align-items: center; gap: 12px;
}
.timer-ring-wrap { position: relative; width: 140px; height: 140px; }
.ring { width: 100%; height: 100%; transform: rotate(-90deg); }
.ring-track { fill: none; stroke: var(--n-200); stroke-width: 8; }
.ring-progress {
  fill: none; stroke: var(--success-500); stroke-width: 8;
  stroke-linecap: round;
  stroke-dasharray: 276.46;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 950ms linear, stroke 300ms var(--ease);
}
.timer-value {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  pointer-events: none;
}
.timer-num {
  font-family: 'Russo One', sans-serif;
  font-size: 36px; color: var(--n-900);
  line-height: 1; font-variant-numeric: tabular-nums;
}
.timer-unit {
  font-size: 10px; font-weight: 800;
  color: var(--n-400); letter-spacing: .12em;
  margin-top: 4px;
}
.timer-caption {
  font-size: 11px; font-weight: 800;
  color: var(--n-500); letter-spacing: .08em;
  text-transform: uppercase;
}

.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.stat-card {
  background: var(--n-0); border-radius: var(--r-sm);
  padding: 12px 8px; text-align: center;
  box-shadow: var(--shadow-xs);
  border: var(--border-subtle);
  transition: transform var(--t-fast);
}
.stat-card.pulse { animation: statPulse 500ms ease; }
@keyframes statPulse {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.1); }
  100% { transform: scale(1); }
}
.stat-val {
  display: block; font-family: 'Russo One', sans-serif;
  font-size: 20px; color: var(--brand-700);
  font-variant-numeric: tabular-nums; line-height: 1.2;
}
.stat-card.green .stat-val { color: var(--success-600); }
.stat-card.orange .stat-val { color: var(--warning-600); }
.stat-lbl {
  display: block; font-size: 10px; font-weight: 800;
  color: var(--n-400); letter-spacing: .08em;
  text-transform: uppercase; margin-top: 2px;
}

/* ============ QUESTION CARD ============ */
.question-card {
  background: var(--n-0); border-radius: var(--r-md);
  padding: 24px; box-shadow: var(--shadow-sm);
  border: var(--border-subtle);
}
.q-head {
  display: flex; justify-content: space-between;
  align-items: center; margin-bottom: 16px;
  gap: 12px; flex-wrap: wrap;
}
.q-badge {
  padding: 4px 10px;
  background: var(--brand-600); color: #fff;
  font-family: 'Russo One', sans-serif;
  font-size: 11px;
  border-radius: var(--r-full); letter-spacing: .06em;
}
.q-chapter {
  padding: 4px 10px;
  background: var(--brand-50); color: var(--brand-700);
  font-size: 11px; font-weight: 800;
  border-radius: var(--r-full);
  letter-spacing: .04em;
  border: 1px solid var(--brand-100);
}
.q-text {
  font-family: 'Exo 2', sans-serif;
  font-size: 17px; font-weight: 600;
  line-height: 1.55; color: var(--n-900);
  margin-bottom: 20px;
}

/* ============ OPTIONS ============ */
.options { display: flex; flex-direction: column; gap: 8px; }
.opt {
  display: flex; align-items: center; gap: 12px;
  width: 100%; min-height: 56px;
  padding: 12px 16px; text-align: left;
  background: var(--n-0);
  border: 1.5px solid var(--n-200);
  border-radius: var(--r-sm);
  font-size: 15px; font-weight: 500; line-height: 1.4;
  color: var(--n-800); cursor: pointer;
  transition: all var(--t-base);
}
.opt:hover:not(:disabled) {
  border-color: var(--brand-400); background: var(--brand-50);
  transform: translateY(-1px); box-shadow: var(--shadow-sm);
}
.opt:active:not(:disabled) { transform: scale(.985); }

.opt-letter {
  flex-shrink: 0; width: 32px; height: 32px;
  border-radius: 8px; background: var(--n-100);
  color: var(--n-600);
  font-family: 'Russo One', sans-serif;
  font-size: 13px;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--t-base);
}
.opt-text { flex: 1; }
.opt-icon {
  flex-shrink: 0; width: 20px; height: 20px;
  opacity: 0; transition: opacity var(--t-base);
}
.opt:disabled { cursor: default; }

.opt.correct {
  border-color: var(--success-500); background: var(--success-50);
  color: var(--success-700);
}
.opt.correct .opt-letter { background: var(--success-500); color: #fff; }
.opt.correct .opt-icon { opacity: 1; color: var(--success-600); }

.opt.wrong {
  border-color: var(--danger-500); background: var(--danger-50);
  color: var(--danger-700);
}
.opt.wrong .opt-letter { background: var(--danger-500); color: #fff; }
.opt.wrong .opt-icon { opacity: 1; color: var(--danger-600); }

.opt.dim { opacity: .5; }

.feedback {
  margin-top: 16px; padding: 0 16px;
  border-radius: var(--r-sm);
  font-size: 14px; font-weight: 600; line-height: 1.5;
  max-height: 0; overflow: hidden;
  transition: all var(--t-slow);
}
.feedback.show { padding: 14px 16px; max-height: 240px; }
.feedback.ok { background: var(--success-50); color: var(--success-700); border: 1px solid var(--success-100); }
.feedback.no { background: var(--danger-50); color: var(--danger-700); border: 1px solid var(--danger-100); }

.next-btn {
  width: 100%; margin-top: 16px; padding: 14px;
  border-radius: var(--r-sm); font-size: 15px;
  font-weight: 700; color: #fff;
  background: var(--brand-600);
  box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 4px 12px rgba(234,88,12,.30);
  display: none; transition: all var(--t-base);
}
.next-btn:hover { background: var(--brand-700); transform: translateY(-1px); }
.next-btn:active { transform: scale(.98); }
.next-btn.show { display: block; animation: slideDown 250ms var(--ease); }
@keyframes slideDown {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============ RESULT ============ */
.result-card {
  background: var(--n-0); border-radius: var(--r-lg);
  padding: 32px 24px; box-shadow: var(--shadow-lg);
  border: var(--border-subtle);
  max-width: 720px; margin: 0 auto; text-align: center;
}
.result-top {
  display: flex; flex-direction: column;
  align-items: center; gap: 16px; margin-bottom: 24px;
}
.result-ring { position: relative; width: 180px; height: 180px; }
.result-ring .ring-progress { stroke: var(--brand-500); transition: stroke-dashoffset 1.2s var(--ease); }
.result-percent {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.result-percent-num {
  font-family: 'Russo One', sans-serif;
  font-size: 44px; color: var(--n-900);
  line-height: 1;
}
.result-percent-lbl {
  font-size: 11px; font-weight: 800;
  color: var(--n-500); letter-spacing: .1em;
  text-transform: uppercase; margin-top: 6px;
}
.result-title {
  font-family: 'Russo One', sans-serif;
  font-size: 26px; color: var(--n-900);
  margin-bottom: 6px;
}
.result-msg {
  color: var(--n-500); font-size: 15px;
  max-width: 460px; line-height: 1.55;
}
.result-stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 12px; margin-bottom: 24px;
}
.result-stat {
  background: var(--n-50); border-radius: var(--r-sm);
  padding: 16px 12px; border: 1px solid var(--n-100);
}
.result-stat-val {
  display: block; font-family: 'Russo One', sans-serif;
  font-size: 22px; color: var(--brand-700); line-height: 1.2;
}
.result-stat-lbl {
  display: block; font-size: 10px; font-weight: 800;
  color: var(--n-500); letter-spacing: .1em;
  text-transform: uppercase; margin-top: 4px;
}
.result-stat.green .result-stat-val { color: var(--success-600); }
